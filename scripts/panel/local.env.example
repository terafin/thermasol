# Copy to local.env (git-ignored) and fill in for your panel. Sourced by lib.sh.
PANEL=192.168.1.50:5555                       # the panel's adb-over-TCP address
# BT=$HOME/android15-build/imx-android-15.0.0_1.2.0/android_build   # NXP Android 15 tree (default shown)
# WORK=$HOME/panel-work                       # pinned base images + build outputs (default shown)

# Power-cycling the panel (recover.sh, wedged boots) goes through a Home Assistant switch.
HA_URL=http://homeassistant.local:8123
HA_SWITCH=switch.steam_shower_power
# Either the token itself, or a command that prints it (preferred: keeps it out of this file).
# HA_TOKEN=...
# HA_TOKEN_CMD='op read "op://Vault/Home Assistant/credential"'
