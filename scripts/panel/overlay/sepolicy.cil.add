(allow hal_audio_default self (udp_socket (create bind connect read write getopt setopt ioctl)))
(allow hal_audio_default self (tcp_socket (create bind connect listen accept read write getopt setopt shutdown ioctl)))
(allow hal_audio_default vendor_public_default_prop (property_service (set)))
(allow hal_audio_default vendor_default_prop (property_service (set)))
(allow hal_audio_default property_socket (sock_file (write)))
(allow hal_audio_default init (unix_stream_socket (connectto)))
(dontaudit hal_camera_default system_data_file (dir (search)))
(dontaudit hal_graphics_composer_default system_data_file (dir (search)))
(dontaudit init-insmod-sh system_lib_file (system (module_load)))
(dontaudit init-insmod-sh init-insmod-sh_exec (file (ioctl)))
(dontaudit hal_sensors_default system_server (binder (call)))
(dontaudit vendor_init build_prop (property_service (set)))
(dontaudit vendor_init default_prop (property_service (set)))
(dontaudit vendor_init future_pm_prop (property_service (set)))
