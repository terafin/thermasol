+void StreamSonos::want(const std::string& ip, bool playing) {
+    { std::lock_guard<std::mutex> g(mCtlM); if (!ip.empty()) mWantIp = ip; mWantPlaying = playing; }
+    mCtlCv.notify_all();
+}
+// Drives the player toward the wanted state. Owns every UPnP call. Starts the player as soon as audio
+// flows; stops it only after audio has been idle for kIdleStopMs (the reference stream drops to
+// standby on short gaps, which must not stop and restart the player).
+void StreamSonos::controlLoop() {
+    constexpr int64_t kIdleStopMs = 15000;
+    std::string haveIp; bool havePlaying = false;
+    std::unique_lock<std::mutex> lk(mCtlM);
+    while (!mCtlExit) {
+        mCtlCv.wait_for(lk, std::chrono::milliseconds(500));
+        if (mCtlExit) break;
+        std::string ip = mWantIp; bool playing = mWantPlaying;
+        int64_t idleMs = (::android::uptimeNanos() - mLastAudioNs) / 1000000;
+        lk.unlock();
+        bool stopNow = havePlaying && (ip != haveIp || (!playing && idleMs > kIdleStopMs));
+        if (stopNow) { upnpStop(haveIp); havePlaying = false; LOG(INFO) << "stop " << haveIp; }
+        if (playing && !ip.empty() && !havePlaying) {
+            std::string uri = "http://" + panelIp() + ":" + std::to_string(kHttpPort) + "/live.wav";
+            havePlaying = upnpPlayUri(ip, uri); haveIp = ip;
+            LOG(INFO) << "play: " << ip << " <- " << uri << (havePlaying ? " ok" : " FAILED (retry)");
+        }
+        lk.lock();
+    }
+    lk.unlock();
+    if (havePlaying) upnpStop(haveIp);
+}
+ndk::ScopedAStatus StreamSonos::setConnectedDevices(const std::vector<AudioDevice>& devices) {
+    // The device address is the player's IP (an attached bus device per amp).
+    if (!devices.empty() && devices[0].address.getTag() == AudioDeviceAddress::id) {
+        std::string ip = devices[0].address.get<AudioDeviceAddress::id>();
+        bool playing; { std::lock_guard<std::mutex> g(mCtlM); playing = mWantPlaying; }
+        if (!ip.empty()) { want(ip, playing); LOG(INFO) << __func__ << ": player " << ip; }
+    }
+    return StreamCommonImpl::setConnectedDevices(devices);
+}
