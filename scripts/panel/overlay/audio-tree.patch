+::android::status_t StreamSonos::transfer(void* buffer, size_t frameCount,
+                                          size_t* actualFrameCount, int32_t*) {
+    { std::lock_guard<std::mutex> g(mCtlM);
+      mLastAudioNs = ::android::uptimeNanos();
+      if (!mWantPlaying) { mWantPlaying = true; mCtlCv.notify_all(); } }  // never blocks on the network
+    mSink->push(static_cast<const int8_t*>(buffer), frameCount * mFrameSizeBytes);
+    *actualFrameCount = frameCount;
+    // Real-time pacing, as the reference stub does: the player pulls at the sample rate.
+    mFramesSinceStart += frameCount;
+    const long bufferUs = frameCount * MICROS_PER_SECOND / mSampleRate;
+    const auto elapsedUs = (::android::uptimeNanos() - mStartTimeNs) / NANOS_PER_MICROSECOND;
+    const long aheadUs = mFramesSinceStart * MICROS_PER_SECOND / mSampleRate - elapsedUs;
+    if (aheadUs > 0) usleep(std::min(aheadUs, bufferUs));
+    return ::android::OK;
+}
+void StreamSonos::shutdown() {
+    want("", false);
+    if (mSink) mSink->stop();
+}
+StreamOutSonos::StreamOutSonos(StreamContext&& context, const SourceMetadata& sourceMetadata,
+                               const std::optional<AudioOffloadInfo>& offloadInfo)
+    : StreamOut(std::move(context), offloadInfo), StreamSonos(&mContextInstance, sourceMetadata) {}
+}  // namespace aidl::android::hardware::audio::core
