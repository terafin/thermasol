+// ---------------------------------------------------------------------------
+// Ring buffer + HTTP sink (plain framing — Sonos cannot decode chunked!)
+// ---------------------------------------------------------------------------
+class HttpSinkImpl {
+public:
+    void start() {
+        running_ = true;
+        httpThread_ = std::thread([this] { httpLoop(); });
+    }
+    void stop() {
+        running_ = false;
+        if (listenFd_ >= 0) ::shutdown(listenFd_, SHUT_RDWR);
+        if (httpThread_.joinable()) httpThread_.join();
+        if (listenFd_ >= 0) close(listenFd_);
+        listenFd_ = -1;
+        // client threads use this object: wait until every one has left before it can be destroyed
+        for (int i = 0; i < 300 && clients_.load() > 0; i++) usleep(10000);
+    }
+    void push(const int8_t* data, size_t bytes) {
+        std::lock_guard<std::mutex> g(ringM_);
+        size_t off = wPos_ % kRingSize;
+        if (off + bytes <= kRingSize) memcpy(ring_.get() + off, data, bytes);
+        else {
+            size_t first = kRingSize - off;
+            memcpy(ring_.get() + off, data, first);
+            memcpy(ring_.get(), data + first, bytes - first);
+        }
+        wPos_ += bytes;
+    }
+    void flush() {
+        std::lock_guard<std::mutex> g(ringM_);
+        memset(ring_.get(), 0, kRingSize);
+        rPos_ = wPos_;
+    }
+private:
+    static constexpr uint8_t wavHdr[44] = {
+        'R','I','F','F', 0xFF,0xFF,0xFF,0xFF, 'W','A','V','E','f','m','t',' ',
+        // PCM, 2 ch, 48000 Hz (0xBB80), 192000 B/s (0x2EE00), block align 4, 16-bit: the format
+        // the stream actually carries (the old bytes said 15424 Hz, so the player rejected it)
+        16,0,0,0, 1,0, 2,0, 0x80,0xBB,0,0, 0x00,0xEE,0x02,0, 4,0, 16,0,
+        'd','a','t','a', 0xFF,0xFF,0xFF,0xFF};
+
+    void httpLoop() {
+        listenFd_ = socket(AF_INET, SOCK_STREAM, 0);
+        int one = 1;
+        setsockopt(listenFd_, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+        sockaddr_in sa{};
+        sa.sin_family = AF_INET;
+        sa.sin_addr.s_addr = INADDR_ANY;
+        sa.sin_port = htons(kHttpPort);
+        if (bind(listenFd_, (sockaddr*)&sa, sizeof(sa)) < 0 || listen(listenFd_, 4) < 0) {
+            ALOGE("http sink bind :%d failed", kHttpPort);
+            return;
+        }
+        ALOGI("http sink listening on :%d", kHttpPort);
+        // One thread per client: a player often opens a probe connection, then the real fetch; the
+        // second must never wait behind the first.
+        while (running_) {
+            sockaddr_in ca{};
+            socklen_t cl = sizeof(ca);
+            int c = accept(listenFd_, (sockaddr*)&ca, &cl);
+            if (c < 0) continue;
+            std::thread([this, c] { serveClient(c); }).detach();
+        }
+    }
+    // Streams the live WAV at exactly real time (48 kHz stereo 16-bit = 192000 B/s), filling gaps
+    // with silence, so the player sees a steady live stream.
+    void serveClient(int c) {
+        clients_++;
+        struct Leave { std::atomic<int>& n; ~Leave() { n--; } } leave{clients_};
+        timeval stv{1, 0}; setsockopt(c, SOL_SOCKET, SO_SNDTIMEO, &stv, sizeof stv);  // never block exit
+        char rb[1024];
+        size_t rl = 0;
+        timeval tv{5, 0}; setsockopt(c, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);
+        while (rl < sizeof(rb) - 1) {
+            ssize_t n = recv(c, rb + rl, sizeof(rb) - 1 - rl, 0);
+            if (n <= 0) break;
+            rl += n; rb[rl] = 0;
+            if (strstr(rb, "\r\n\r\n")) break;
+        }
+        if (rl == 0) { ::close(c); return; }
+        std::string resp = "HTTP/1.1 200 OK\r\nContent-Type: audio/wav\r\n"
+                           "Connection: close\r\n\r\n";
+        if (send(c, resp.data(), resp.size(), MSG_NOSIGNAL) < 0) { ::close(c); return; }
+        uint8_t hdr[44];
+        memcpy(hdr, wavHdr, 44);
+        if (send(c, hdr, 44, MSG_NOSIGNAL) < 0) { ::close(c); return; }
+        constexpr size_t kChunk = 3840;            // 20 ms at 192000 B/s
+        constexpr int64_t kChunkNs = 20000000;
+        int64_t next = ::android::uptimeNanos();
+        size_t rpos;
+        { std::lock_guard<std::mutex> g(ringM_); rpos = wPos_; }  // start at "now", no backlog
+        while (running_) {
+            uint8_t chunk[kChunk];
+            {
+                std::lock_guard<std::mutex> g(ringM_);
+                size_t avail = wPos_ > rpos ? wPos_ - rpos : 0;
+                if (avail > kRingSize) { rpos = wPos_ - kChunk; avail = kChunk; }  // fell behind: skip
+                size_t take = avail < kChunk ? avail : kChunk;
+                size_t off = rpos % kRingSize;
+                if (off + take <= kRingSize) memcpy(chunk, ring_.get() + off, take);
+                else { size_t first = kRingSize - off; memcpy(chunk, ring_.get() + off, first);
+                       memcpy(chunk + first, ring_.get(), take - first); }
+                if (take < kChunk) memset(chunk + take, 0, kChunk - take);  // gap -> silence
+                rpos += take;
+            }
+            // MSG_NOSIGNAL: a player that hangs up must not SIGPIPE the whole audio service
+            if (send(c, chunk, kChunk, MSG_NOSIGNAL) < 0) break;
+            next += kChunkNs;
+            int64_t wait = next - ::android::uptimeNanos();
+            if (wait > 0) usleep(wait / 1000); else if (wait < -200000000) next = ::android::uptimeNanos();
+        }
+        ::close(c);
+    }
+    std::atomic<bool> running_{false};
+    std::atomic<int> clients_{0};
+    std::thread httpThread_;
+    int listenFd_ = -1;
+    std::mutex ringM_;
+    std::unique_ptr<int8_t[]> ring_{new int8_t[kRingSize]()};
+    size_t rPos_ = 0, wPos_ = 0;
+};
+
+// ---------------------------------------------------------------------------
+
+static std::string panelIp() {
+    const char* ifaces[] = {"eth0", "wlan0"};
+    std::string ip;
+    int fd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (fd >= 0) {
+        for (auto ifc : ifaces) {
+            struct ifreq ifr{};
+            strncpy(ifr.ifr_name, ifc, IFNAMSIZ - 1);
+            if (ioctl(fd, SIOCGIFADDR, &ifr) == 0) {
+                auto* sa = (sockaddr_in*)&ifr.ifr_addr;
+                if (sa->sin_addr.s_addr != 0) {
+                    char b[32]; inet_ntop(AF_INET, &sa->sin_addr, b, sizeof(b)); ip = b; break;
+                }
+            }
+        }
+        ::close(fd);
+    }
+    return ip;
+}
