+static const int kHttpPort = 8091;
+static const int kSampleRate = 48000;
+static const size_t kRingSize = 48000 * 4 * 6;
+static bool upnpCall(const std::string& ip, const std::string& service,
+                     const std::string& bodyXml, const std::string& soapAction) {
+    char url[128];
+    snprintf(url, sizeof(url), "http://%s:1400/MediaRenderer/%s/Control", ip.c_str(), service.c_str());
+    std::string body =
+        "<?xml version=\"1.0\" encoding=\"utf-8\"?>"
+        "<s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\" "
+        "s:encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\">"
+        "<s:Body>" + bodyXml + "</s:Body></s:Envelope>";
+    std::string req = "POST " + std::string(url) + " HTTP/1.1\r\n"
+        "Host: " + ip + ":1400\r\n"
+        "Content-Type: text/xml; charset=\"utf-8\"\r\n"
+        "SOAPACTION: \"" + soapAction + "\"\r\n"
+        "Connection: close\r\n"
+        "Content-Length: " + std::to_string(body.size()) + "\r\n\r\n" + body;
+
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) return false;
+    sockaddr_in sa{};
+    sa.sin_family = AF_INET;
+    sa.sin_port = htons(1400);
+    inet_pton(AF_INET, ip.c_str(), &sa.sin_addr);
+    if (connect(fd, (sockaddr*)&sa, sizeof(sa)) < 0) { close(fd); return false; }
+    send(fd, req.data(), req.size(), MSG_NOSIGNAL);
+    char buf[2048];
+    ssize_t n = recv(fd, buf, sizeof(buf) - 1, 0);
+    close(fd);
+    if (n <= 0) return false;
+    buf[n] = 0;
+    return strstr(buf, "200") != nullptr;
+}
+
+static bool upnpPlayUri(const std::string& ip, const std::string& uri) {
+    std::string body =
+        "<u:SetAVTransportURI xmlns:u=\"urn:schemas-upnp-org:service:AVTransport:1\">"
+        "<InstanceID>0</InstanceID><CurrentURI>" + uri +
+        "</CurrentURI><CurrentURIMetaData></CurrentURIMetaData></u:SetAVTransportURI>";
+    if (!upnpCall(ip, "AVTransport", body,
+                  "urn:schemas-upnp-org:service:AVTransport:1#SetAVTransportURI")) return false;
+    std::string pbody =
+        "<u:Play xmlns:u=\"urn:schemas-upnp-org:service:AVTransport:1\">"
+        "<InstanceID>0</InstanceID><Speed>1</Speed></u:Play>";
+    return upnpCall(ip, "AVTransport", pbody,
+                    "urn:schemas-upnp-org:service:AVTransport:1#Play");
+}
+
+static bool upnpStop(const std::string& ip) {
+    std::string body =
+        "<u:Stop xmlns:u=\"urn:schemas-upnp-org:service:AVTransport:1\">"
+        "<InstanceID>0</InstanceID><Speed>1</Speed></u:Stop>";
+    return upnpCall(ip, "AVTransport", body,
+                    "urn:schemas-upnp-org:service:AVTransport:1#Stop");
+}
