+SonosDiscovery& discovery() {
+    static SonosDiscovery d(1);
+    return d;
+}
+// Builds before this one saved every amp they found in persist.vendor.sonos.amp.<n>. Nothing is
+// saved now; blank any such entries so no list survives on the panel.
+void clearOldAmpList() {
+    for (int n = 0; n < 64; n++) {
+        std::string k = "persist.vendor.sonos.amp." + std::to_string(n);
+        char v[PROP_VALUE_MAX] = {0};
+        if (__system_property_get(k.c_str(), v) <= 0) break;
+        __system_property_set(k.c_str(), "");
+    }
+}
+// The audio system reads its outputs once, when this module is created. When the background search
+// finds a player that is not an output yet (or a player's name changed), restart the audio HAL: its
+// start-up search then lists the player.
+void watchForNewAmps(std::map<std::string, std::string> listed) {   // ip -> name
+    std::thread([listed]() {
+        int stable = 0; size_t last = 0;
+        while (true) {
+            sleep(1);
+            auto all = discovery().all();
+            stable = (all.size() == last) ? stable + 1 : 0; last = all.size();
+            if (stable < 5) continue;
+            for (auto& z : all) {
+                auto it = listed.find(z.ip);
+                if (it == listed.end() || it->second != z.name) {
+                    LOG(INFO) << "Sonos player " << z.name << " (" << z.ip
+                              << ") is not listed yet; restarting the audio HAL to list it";
+                    __system_property_set("vendor.sonos.rooms_gen",
+                                          std::to_string(time(nullptr)).c_str());
+                    return;  // audio-sonos.rc restarts this HAL
+                }
+            }
+        }
+    }).detach();
+}
+}  // namespace
+// static
+std::unique_ptr<Module::Configuration> ModuleSonos::withRooms(std::unique_ptr<Configuration>&& config) {
+    clearOldAmpList();
+    discovery().searchNow();  // live search; returns at once if the network is not up yet
+    int32_t mixId = -1;
+    for (auto& p : config->ports)
+        if (p.ext.getTag() == AudioPortExt::Tag::mix) { mixId = p.id; break; }
+    std::map<std::string, std::string> listed;   // ip -> name: every player that answered just now
+    for (auto& z : discovery().all()) listed[z.ip] = z.name;
+    for (auto& a : listed) {
+        AudioPort p;
+        p.id = config->nextPortId++;
+        // port names must be unique (audio policy merges same-named ports: two amps both called
+        // "Loft" became one); the name shown to the user comes from vendor.sonos.name.<ip>
+        p.name = a.second + " " + a.first;
+        p.flags = AudioIoFlags::make<AudioIoFlags::Tag::output>(0);
+        AudioPortDeviceExt d;
+        d.device.type.type = AudioDeviceType::OUT_BUS;
+        d.device.address = AudioDeviceAddress::make<AudioDeviceAddress::Tag::id>(a.first);
+        p.ext = AudioPortExt::make<AudioPortExt::Tag::device>(d);
+        if (mixId >= 0)
+            for (auto& m : config->ports) if (m.id == mixId) p.profiles = m.profiles;
+        config->ports.push_back(p);
+        if (mixId >= 0) {
+            AudioRoute r; r.sourcePortIds = {mixId}; r.sinkPortId = p.id;
+            config->routes.push_back(r);
+        }
+        std::string key = a.first; for (auto& ch : key) if (ch == '.') ch = '_';
+        __system_property_set(("vendor.sonos.name." + key).c_str(), a.second.c_str());
+        LOG(INFO) << "Sonos amp " << a.second << " (" << a.first << ") port " << p.id;
+    }
+    discovery().start();
+    watchForNewAmps(listed);
+    return std::move(config);
+}
