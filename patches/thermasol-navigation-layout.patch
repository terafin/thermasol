+++ b/util/Utils.smali
@@ -1222,7 +1222,7 @@
 
     move-result-object p0
 
-    const/16 v0, 0x1006
+    const/16 v0, 0x4
 
     invoke-virtual {p0, v0}, Landroid/view/View;->setSystemUiVisibility(I)V
 
--- a/activities/MainControl.smali
+++ b/activities/MainControl.smali
@@ -866,9 +866,24 @@
 
     move-result v0
 
+    const/4 v0, -0x1
+
     iput v0, v2, Landroid/view/ViewGroup$LayoutParams;->height:I
 
+    instance-of v0, v2, Landroid/widget/RelativeLayout$LayoutParams;
+
+    if-eqz v0, :cond_67
+
+    check-cast v2, Landroid/widget/RelativeLayout$LayoutParams;
+
+    const/4 v0, 0x2
+
+    const v3, 0x7f0a0045
+
+    invoke-virtual {v2, v0, v3}, Landroid/widget/RelativeLayout$LayoutParams;->addRule(II)V
+
     .line 345
+    :cond_67
